-        screenLayout.BufferWidth(),
-        screenLayout.BufferHeight(),
+        outW,
+        outH,
         0
     );
     TracyGpuCollect;
@@ -635,6 +680,11 @@ void MelonDsDs::OpenGLRenderState::ContextDestroyed() {
         ubo = 0;
     }
 
+    if (_wideReadFbo) {
+        glDeleteFramebuffers(1, &_wideReadFbo);
+        _wideReadFbo = 0;
+    }
+
 #if defined(HAVE_TRACY) && !defined(__APPLE__)
     _tracyCapture = std::nullopt;
 #endif
