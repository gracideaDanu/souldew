+void SPU::SouldewMixAsync(s16* out, int samples, u16 chanMask)
+{
+    if (!out || samples <= 0) return;
+    if (Mute || !(Cnt & (1<<15)))
+    {
+        memset(out, 0, (size_t)samples * 2 * sizeof(s16));
+        return;
+    }
+
+    auto chanOn = [&](int i) -> bool {
+        if (chanMask == 0xFFFF) return true;
+        if (!(chanMask & (1u << i))) return false;
+        if (i != 0 && i != 14 && ((AsyncChannels[i].Cnt >> 27) & 3) == 1) return false;
+        return true;
+    };
+
+    const u32 spucycles = MixInterval;
+    for (int n = 0; n < samples; n++)
+    {
+        s32 left = 0, right = 0;
+        s32 leftoutput = 0, rightoutput = 0;
+
+        s32 ch0 = AsyncChannels[0].DoRun(spucycles);
+        s32 ch1 = AsyncChannels[1].DoRun(spucycles);
+        s32 ch2 = AsyncChannels[2].DoRun(spucycles);
+        s32 ch3 = AsyncChannels[3].DoRun(spucycles);
+
+        if (chanOn(0)) AsyncChannels[0].PanOutput(ch0, left, right);
+        if (chanOn(2)) AsyncChannels[2].PanOutput(ch2, left, right);
+        if (chanOn(1) && !(Cnt & (1<<12))) AsyncChannels[1].PanOutput(ch1, left, right);
+        if (chanOn(3) && !(Cnt & (1<<13))) AsyncChannels[3].PanOutput(ch3, left, right);
+
+        for (int i = 4; i < 16; i++)
+        {
+            s32 channel = AsyncChannels[i].DoRun(spucycles);
+            if (chanOn(i)) AsyncChannels[i].PanOutput(channel, left, right);
+        }
+
+        switch (Cnt & 0x0300)
+        {
+        case 0x0000: leftoutput = left; break;
+        case 0x0100: leftoutput = chanOn(1) ? (((s64)ch1 * (128 - AsyncChannels[1].Pan)) >> 10) : 0; break;
+        case 0x0200: leftoutput = chanOn(3) ? (((s64)ch3 * (128 - AsyncChannels[3].Pan)) >> 10) : 0; break;
+        case 0x0300: leftoutput = (chanOn(1) ? (((s64)ch1 * (128 - AsyncChannels[1].Pan)) >> 10) : 0) + (chanOn(3) ? (((s64)ch3 * (128 - AsyncChannels[3].Pan)) >> 10) : 0); break;
+        }
+
+        switch (Cnt & 0x0C00)
+        {
+        case 0x0000: rightoutput = right; break;
+        case 0x0400: rightoutput = chanOn(1) ? (((s64)ch1 * AsyncChannels[1].Pan) >> 10) : 0; break;
+        case 0x0800: rightoutput = chanOn(3) ? (((s64)ch3 * AsyncChannels[3].Pan) >> 10) : 0; break;
+        case 0x0C00: rightoutput = (chanOn(1) ? (((s64)ch1 * AsyncChannels[1].Pan) >> 10) : 0) + (chanOn(3) ? (((s64)ch3 * AsyncChannels[3].Pan) >> 10) : 0); break;
+        }
+
+        leftoutput = (((s64)leftoutput * MasterVolume) >> 7) >> 8;
+        rightoutput = (((s64)rightoutput * MasterVolume) >> 7) >> 8;
+
+        if (ApplyBias)
+        {
+            leftoutput += (Bias << 6) - 0x8000;
+            rightoutput += (Bias << 6) - 0x8000;
+        }
+
+        out[n * 2] = (s16)std::clamp(leftoutput, -0x8000, 0x7FFF);
+        out[n * 2 + 1] = (s16)std::clamp(rightoutput, -0x8000, 0x7FFF);
+    }
+}
